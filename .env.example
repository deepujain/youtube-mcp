# Copy to .env (never commit real values). The server reads all config from env vars.
# Public reads (search, video details) need only the API key.
YOUTUBE_API_KEY=

# Private reads (subscriptions, my playlists) and ALL writes need a user OAuth
# access token with scopes:
#   https://www.googleapis.com/auth/youtube.readonly
#   https://www.googleapis.com/auth/youtube.force-ssl
# Obtain via Google's OAuth 2.0 flow for your Cloud project's OAuth client,
# then paste the access token here. Refresh it when it expires.
YOUTUBE_OAUTH_TOKEN=

# Server bind (streamable HTTP transport)
YOUTUBE_HOST=127.0.0.1
YOUTUBE_PORT=8000

# How long a pending write approval stays valid (seconds)
YOUTUBE_APPROVAL_TTL_SECONDS=600

# Optional explicit egress proxy (the server ignores ambient proxy env vars).
# YOUTUBE_HTTP_PROXY=
# YOUTUBE_HTTPS_PROXY=

# Optional: path to a PEM CA bundle, if your egress proxy re-signs TLS with a
# private CA. Extends the default trust store, never replaces it.
# YOUTUBE_CA_BUNDLE=
