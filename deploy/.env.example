# YouTube API key for public reads (search, video details). REQUIRED.
# Store the real value in a secrets manager; never commit it.
YOUTUBE_API_KEY=

# Bind address / port inside the container. Leave as-is for Docker/ECS.
YOUTUBE_HOST=0.0.0.0
YOUTUBE_PORT=8000

# Single-user OAuth token (dev only). Leave UNSET in production:
# per-user tokens are supplied by the connector platform's credential flow
# at connect time, not baked into the server.
# YOUTUBE_OAUTH_TOKEN=

# How long a pending write-approval stays valid, in seconds.
YOUTUBE_APPROVAL_TTL_SECONDS=600
